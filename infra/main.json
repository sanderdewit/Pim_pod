    "tokenClaims": "[concat(createArray(createObject('name', 'iss', 'value', format('{0}{1}/v2.0', environment().authentication.loginEndpoint, subscription().tenantId)), createObject('name', 'aud', 'value', parameters('apiAppId'))), if(empty(parameters('pimCallerAppId')), createArray(), createArray(createObject('name', 'azp', 'value', parameters('pimCallerAppId')))))]",
