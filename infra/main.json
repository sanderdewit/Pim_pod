      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
    },
    "customExtensionTargetUrl": {
      "type": "string",
      "metadata": {
        "description": "Target URL for the PIM custom extension: the trigger URL without the SAS signature, so only OAuth requests are accepted."
      },
      "value": "[format('{0}/triggers/manual/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0', replace(reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01').accessEndpoint, ':443', ''))]"
    },
    "applicationIdUri": {
      "type": "string",
      "metadata": {
        "description": "Application ID URI to set on the app registration. Its host must match the host of the target URL."
      },
      "value": "[format('api://{0}/{1}', split(split(replace(reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01').accessEndpoint, ':443', ''), '://')[1], '/')[0], parameters('apiAppId'))]"
    }
  }
}