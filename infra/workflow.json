{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$connections": {
        "type": "Object",
        "defaultValue": {}
      },
      "syncServicePrincipalId": {
        "type": "String",
        "defaultValue": "7dc02c72-03d1-462b-bf75-335fbffaa19e",
        "metadata": {
          "description": "Object ID of the Cloud Sync service principal that owns the provisioning job."
        }
      },
      "syncJobId": {
        "type": "String",
        "defaultValue": "AAD2ADGroupProvisioning.bbafb01eee104a81847ce62a41c8c1d8.84174f1a-dc83-40c7-b120-c099a8c0d903",
        "metadata": {
          "description": "ID of the Entra ID to AD group provisioning job (AAD2ADGroupProvisioning.*)."
        }
      },
      "syncRuleId": {
        "type": "String",
        "defaultValue": "auto",
        "metadata": {
          "description": "ID of the group synchronization rule in the job schema. 'auto' looks it up at run time."
        }
      },
      "syncOnRemoval": {
        "type": "Bool",
        "defaultValue": true,
        "metadata": {
          "description": "Run provisionOnDemand again when the user leaves the group (activation expired or deactivated), so the AD membership is removed promptly."
        }
      },
      "graphApiVersion": {
        "type": "String",
        "defaultValue": "v1.0",
        "metadata": {
          "description": "Microsoft Graph version used for provisionOnDemand."
        }
      },
      "evaluationOutcome": {
        "type": "String",
        "defaultValue": "Approved",
        "metadata": {
          "description": "Decision returned to PIM: 'Approved' (continue the normal PIM flow, including any human approval) or 'AutoApproved' (skip manual approval)."
        }
      }
    },
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string" },
              "action": { "type": "string" },
              "justification": { "type": "string" },
              "principalId": { "type": "string" },
              "accessId": { "type": "string" },
              "groupId": { "type": "string" },
              "scheduleInfo": { "type": "object" },
              "ticketInfo": { "type": "object" }
            }
          }
        }
      }
    },
    "actions": {
      "Respond_to_PIM": {
        "runAfter": {},
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "evaluationId": "@{guid()}",
            "evaluationOutcome": "@{parameters('evaluationOutcome')}",
            "reason": [
              "Accepted by @{workflow()?['name']} (run @{workflow()?['run']?['name']}). Active Directory group sync is queued."
            ]
          }
        }
      },
      "Parse_request": {
        "runAfter": {
          "Respond_to_PIM": [ "Succeeded", "Failed", "TimedOut" ]
        },
        "type": "Compose",
        "inputs": {
          "requestId": "@{triggerBody()?['id']}",
          "action": "@{toLower(coalesce(triggerBody()?['action'], ''))}",
          "groupId": "@{toLower(coalesce(triggerBody()?['groupId'], ''))}",
          "principalId": "@{toLower(coalesce(triggerBody()?['principalId'], ''))}",
          "accessId": "@{toLower(coalesce(triggerBody()?['accessId'], 'member'))}"
        }
      },
      "Initialize_isMember": {
        "runAfter": {
          "Parse_request": [ "Succeeded" ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "isMember",
              "type": "boolean",
              "value": false
            }
          ]
        }
      },
      "Initialize_syncRuleId": {
        "runAfter": {
          "Initialize_isMember": [ "Succeeded" ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "syncRuleId",
              "type": "string",
              "value": "@parameters('syncRuleId')"
            }
          ]
        }
      },
      "Initialize_pollError": {
        "runAfter": {
          "Initialize_syncRuleId": [ "Succeeded" ]
        },
        "type": "InitializeVariable",
        "inputs": {
          "variables": [
            {
              "name": "pollError",
              "type": "string",
              "value": ""
            }
          ]
        }
      },
      "Validate_request": {
        "runAfter": {
          "Initialize_pollError": [ "Succeeded" ]
        },
        "type": "If",
        "expression": {
          "or": [
            { "equals": [ "@outputs('Parse_request')?['groupId']", "" ] },
            { "equals": [ "@outputs('Parse_request')?['principalId']", "" ] }
          ]
        },
        "actions": {
          "Terminate_invalid_payload": {
            "runAfter": {},
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "InvalidPayload",
                "message": "The PIM request did not contain groupId and principalId. Inspect the trigger body in the run history and adjust Parse_request."
              }
            }
          }
        },
        "else": {
          "actions": {}
        }
      },
      "Skip_if_not_member_activation": {
        "runAfter": {
          "Validate_request": [ "Succeeded" ]
        },
        "type": "If",
        "expression": {
          "or": [
            { "not": { "equals": [ "@outputs('Parse_request')?['accessId']", "member" ] } },
            { "equals": [ "@outputs('Parse_request')?['action']", "selfdeactivate" ] },
            { "equals": [ "@outputs('Parse_request')?['action']", "adminremove" ] }
          ]
        },
        "actions": {
          "Terminate_nothing_to_sync": {
            "runAfter": {},
            "type": "Terminate",
            "inputs": {
              "runStatus": "Succeeded"
            }
          }
        },
        "else": {
          "actions": {}
        }
      },
      "Look_up_sync_rule": {
        "runAfter": {
          "Skip_if_not_member_activation": [ "Succeeded" ]
        },
        "type": "If",
        "expression": {
          "or": [
            { "equals": [ "@toLower(trim(variables('syncRuleId')))", "auto" ] },
            { "equals": [ "@trim(variables('syncRuleId'))", "" ] }
          ]
        },
        "actions": {
          "Get_sync_schema": {
            "runAfter": {},
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "https://graph.microsoft.com/@{parameters('graphApiVersion')}/servicePrincipals/@{parameters('syncServicePrincipalId')}/synchronization/jobs/@{parameters('syncJobId')}/schema",
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://graph.microsoft.com"
              }
            }
          },
          "Filter_group_rules": {
            "runAfter": {
              "Get_sync_schema": [ "Succeeded" ]
            },
            "type": "Query",
            "inputs": {
              "from": "@coalesce(body('Get_sync_schema')?['synchronizationRules'], json('[]'))",
              "where": "@contains(toLower(string(coalesce(item()?['objectMappings'], json('[]')))), '\"sourceobjectname\":\"group\"')"
            }
          },
          "Fail_if_no_single_group_rule": {
            "runAfter": {
              "Filter_group_rules": [ "Succeeded" ]
            },
            "type": "If",
            "expression": {
              "and": [
                { "not": { "equals": [ "@length(body('Filter_group_rules'))", 1 ] } }
              ]
            },
            "actions": {
              "Terminate_no_group_rule": {
                "runAfter": {},
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "SyncRuleNotFound",
                    "message": "Found @{length(body('Filter_group_rules'))} group synchronization rules in the job schema. Set the syncRuleId parameter to the right one (see the output of Get_sync_schema)."
                  }
                }
              }
            },
            "else": {
              "actions": {}
            }
          },
          "Set_syncRuleId": {
            "runAfter": {
              "Fail_if_no_single_group_rule": [ "Succeeded" ]
            },
            "type": "SetVariable",
            "inputs": {
              "name": "syncRuleId",
              "value": "@{first(body('Filter_group_rules'))?['id']}"
            }
          }
        },
        "else": {
          "actions": {}
        }
      },
      "Until_member_added": {
        "runAfter": {
          "Look_up_sync_rule": [ "Succeeded" ]
        },
        "type": "Until",
        "expression": "@or(variables('isMember'), not(equals(variables('pollError'), '')))",
        "limit": {
          "count": 5000,
          "timeout": "PT24H"
        },
        "actions": {
          "Check_membership": {
            "runAfter": {},
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "https://graph.microsoft.com/v1.0/users/@{outputs('Parse_request')?['principalId']}/checkMemberGroups",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "groupIds": [ "@{outputs('Parse_request')?['groupId']}" ]
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://graph.microsoft.com"
              }
            }
          },
          "Record_poll_error": {
            "runAfter": {
              "Check_membership": [ "Failed", "TimedOut" ]
            },
            "type": "SetVariable",
            "inputs": {
              "name": "pollError",
              "value": "HTTP @{outputs('Check_membership')?['statusCode']}: @{coalesce(body('Check_membership')?['error']?['message'], string(body('Check_membership')))}"
            }
          },
          "Set_isMember": {
            "runAfter": {
              "Check_membership": [ "Succeeded" ]
            },
            "type": "SetVariable",
            "inputs": {
              "name": "isMember",
              "value": "@contains(toLower(string(coalesce(body('Check_membership')?['value'], json('[]')))), outputs('Parse_request')?['groupId'])"
            }
          },
          "Delay_if_not_member_yet": {
            "runAfter": {
              "Set_isMember": [ "Succeeded" ]
            },
            "type": "If",
            "expression": {
              "and": [
                { "equals": [ "@variables('isMember')", false ] }
              ]
            },
            "actions": {
              "Delay_before_next_check": {
                "runAfter": {},
                "type": "Wait",
                "inputs": {
                  "interval": {
                    "count": "@if(less(iterationIndexes('Until_member_added'), 120), 5, 60)",
                    "unit": "Second"
                  }
                }
              }
            },
            "else": {
              "actions": {}
            }
          }
        }
      },
      "Fail_if_lookup_failed": {
        "runAfter": {
          "Until_member_added": [ "Succeeded", "Failed", "TimedOut" ]
        },
        "type": "If",
        "expression": {
          "and": [
            { "not": { "equals": [ "@variables('pollError')", "" ] } }
          ]
        },
        "actions": {
          "Terminate_lookup_failed": {
            "runAfter": {},
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "GraphLookupFailed",
                "message": "Checking the group membership failed with @{variables('pollError')}. A 403 means the managed identity lacks GroupMember.Read.All or User.ReadBasic.All."
              }
            }
          }
        },
        "else": {
          "actions": {}
        }
      },
      "Fail_if_not_member": {
        "runAfter": {
          "Fail_if_lookup_failed": [ "Succeeded" ]
        },
        "type": "If",
        "expression": {
          "and": [
            { "equals": [ "@variables('isMember')", false ] }
          ]
        },
        "actions": {
          "Terminate_not_member": {
            "runAfter": {},
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "MemberNotAdded",
                "message": "User @{outputs('Parse_request')?['principalId']} did not become a member of group @{outputs('Parse_request')?['groupId']} within 24 hours. Check that the activation wasn't cancelled, and compare the IDs in Parse_request with the user and group."
              }
            }
          }
        },
        "else": {
          "actions": {}
        }
      },
      "Provision_on_demand": {
        "runAfter": {
          "Fail_if_not_member": [ "Succeeded" ]
        },
        "type": "Http",
        "inputs": {
          "method": "POST",
          "uri": "https://graph.microsoft.com/@{parameters('graphApiVersion')}/servicePrincipals/@{parameters('syncServicePrincipalId')}/synchronization/jobs/@{parameters('syncJobId')}/provisionOnDemand",
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "parameters": [
              {
                "ruleId": "@{variables('syncRuleId')}",
                "subjects": [
                  {
                    "objectId": "@{outputs('Parse_request')?['groupId']}",
                    "objectTypeName": "Group",
                    "links": {
                      "members": [
                        {
                          "objectId": "@{outputs('Parse_request')?['principalId']}",
                          "objectTypeName": "User"
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://graph.microsoft.com"
          }
        }
      },
      "Provisioning_result": {
        "runAfter": {
          "Provision_on_demand": [ "Succeeded" ]
        },
        "type": "Compose",
        "inputs": "@if(startsWith(trim(coalesce(body('Provision_on_demand')?['value'], '[]')), '['), json(coalesce(body('Provision_on_demand')?['value'], '[]')), createArray(json(coalesce(body('Provision_on_demand')?['value'], '{}'))))"
      },
      "Filter_failed_entries": {
        "runAfter": {
          "Provisioning_result": [ "Succeeded" ]
        },
        "type": "Query",
        "inputs": {
          "from": "@outputs('Provisioning_result')",
          "where": "@and(not(equals(coalesce(item()?['statusInfo']?['status'], ''), '')), not(contains(createArray('Success', 'Skipped'), coalesce(item()?['statusInfo']?['status'], ''))))"
        }
      },
      "Fail_if_provisioning_failed": {
        "runAfter": {
          "Filter_failed_entries": [ "Succeeded" ]
        },
        "type": "If",
        "expression": {
          "and": [
            { "greater": [ "@length(body('Filter_failed_entries'))", 0 ] }
          ]
        },
        "actions": {
          "Terminate_provisioning_failed": {
            "runAfter": {},
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "ProvisionOnDemandFailed",
                "message": "provisionOnDemand reported @{length(body('Filter_failed_entries'))} failed entries. First: @{first(body('Filter_failed_entries'))?['reportableIdentifier']} @{string(first(body('Filter_failed_entries'))?['statusInfo'])}. See Provisioning_result for all entries."
              }
            }
          }
        },
        "else": {
          "actions": {}
        }
      },
      "Sync_again_on_removal": {
        "runAfter": {
          "Fail_if_provisioning_failed": [ "Succeeded" ]
        },
        "type": "If",
        "expression": {
          "and": [
            { "equals": [ "@parameters('syncOnRemoval')", true ] }
          ]
        },
        "actions": {
          "Until_member_removed": {
            "runAfter": {},
            "type": "Until",
            "expression": "@or(not(variables('isMember')), not(equals(variables('pollError'), '')))",
            "limit": {
              "count": 5000,
              "timeout": "PT25H"
            },
            "actions": {
              "Delay_before_removal_check": {
                "runAfter": {},
                "type": "Wait",
                "inputs": {
                  "interval": {
                    "count": 60,
                    "unit": "Second"
                  }
                }
              },
              "Check_membership_for_removal": {
                "runAfter": {
                  "Delay_before_removal_check": [ "Succeeded" ]
                },
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "https://graph.microsoft.com/v1.0/users/@{outputs('Parse_request')?['principalId']}/checkMemberGroups",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "body": {
                    "groupIds": [ "@{outputs('Parse_request')?['groupId']}" ]
                  },
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://graph.microsoft.com"
                  }
                }
              },
              "Record_poll_error_for_removal": {
                "runAfter": {
                  "Check_membership_for_removal": [ "Failed", "TimedOut" ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "pollError",
                  "value": "HTTP @{outputs('Check_membership_for_removal')?['statusCode']}: @{coalesce(body('Check_membership_for_removal')?['error']?['message'], string(body('Check_membership_for_removal')))}"
                }
              },
              "Set_isMember_for_removal": {
                "runAfter": {
                  "Check_membership_for_removal": [ "Succeeded" ]
                },
                "type": "SetVariable",
                "inputs": {
                  "name": "isMember",
                  "value": "@contains(toLower(string(coalesce(body('Check_membership_for_removal')?['value'], json('[]')))), outputs('Parse_request')?['groupId'])"
                }
              }
            }
          },
          "Provision_on_demand_after_removal": {
            "runAfter": {
              "Until_member_removed": [ "Succeeded", "Failed", "TimedOut" ]
            },
            "type": "Http",
            "inputs": {
              "method": "POST",
              "uri": "https://graph.microsoft.com/@{parameters('graphApiVersion')}/servicePrincipals/@{parameters('syncServicePrincipalId')}/synchronization/jobs/@{parameters('syncJobId')}/provisionOnDemand",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "parameters": [
                  {
                    "ruleId": "@{variables('syncRuleId')}",
                    "subjects": [
                      {
                        "objectId": "@{outputs('Parse_request')?['groupId']}",
                        "objectTypeName": "Group",
                        "links": {
                          "members": [
                            {
                              "objectId": "@{outputs('Parse_request')?['principalId']}",
                              "objectTypeName": "User"
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              "authentication": {
                "type": "ManagedServiceIdentity",
                "audience": "https://graph.microsoft.com"
              }
            }
          },
          "Provisioning_result_after_removal": {
            "runAfter": {
              "Provision_on_demand_after_removal": [ "Succeeded" ]
            },
            "type": "Compose",
            "inputs": "@if(startsWith(trim(coalesce(body('Provision_on_demand_after_removal')?['value'], '[]')), '['), json(coalesce(body('Provision_on_demand_after_removal')?['value'], '[]')), createArray(json(coalesce(body('Provision_on_demand_after_removal')?['value'], '{}'))))"
          }
        },
        "else": {
          "actions": {}
        }
      }
    },
    "outputs": {}
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "value": {}
    }
  }
}
